DATABASE_URL=postgres://tcg:tcg@localhost:5432/tcg
BIND_ADDR=0.0.0.0:8080
RUST_LOG=api=debug,tower_http=debug,info

# Secret de signature des access tokens : 32 caractères minimum.
# Générer une valeur : openssl rand -base64 48
JWT_SECRET=remplacez-moi-par-une-valeur-aleatoire-de-48-caracteres

# Login providers: set at least one. An unset provider is disabled (its route answers 404).
# Apple: bundle ID of the iOS app (audience of Sign in with Apple tokens).
#APPLE_BUNDLE_ID=alexandreodet.tcg
# Google: iOS OAuth client ID (Google Cloud console). If the app also sets a "server client ID",
# use that one here instead: it becomes the audience of the ID token.
GOOGLE_CLIENT_ID=remplacez-moi.apps.googleusercontent.com
